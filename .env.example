# Public URL where the verifier web UI is mounted.
PUBLIC_WEB_URL=http://127.0.0.1:5174/verify

# Optional host API used for login, saved sites, saved models, and saved-site
# verification. Leave empty for standalone temporary verification only.
MODEL_VERIFIER_HOST_API_BASE_URL=

# Optional internal-only host API base URL for server-to-server calls.
# Useful when the verifier service can reach the host API on a Docker network.
MODEL_VERIFIER_HOST_API_INTERNAL_BASE_URL=

# Optional external Docker network that exposes the host API service.
MODEL_VERIFIER_HOST_API_NETWORK=
